# Ключ шифрования хранилища соответствий: 32 байта в кодировке base64.
# Сгенерировать: openssl rand -base64 32
PII_STORE_KEY=

# Хеши ключей доступа систем-потребителей.
# Сгенерировать ключ: openssl rand -hex 16
# Получить хеш:       printf '%s' "<ключ>" | shasum -a 256 | cut -d' ' -f1
KILO_KEY_SHA256=
JURY_KEY_SHA256=
JURY2_KEY_SHA256=

# Адрес и ключ языковой модели для режима прокси.
ALFAGEN_URL=https://alfagen.alfabank.ru/continue-dev/v1
ALFAGEN_TOKEN=
