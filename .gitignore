.env
.keys-plain.txt
/bin/
/dist/
*.out
# Отчёты о покрытии. Узор нарочно узкий: прежний coverage.* проглатывал
# исходник internal/api/coverage.go, файл молча не попадал в git, ветка
# не собиралась, а ворота этого не видели, потому что на диске он был.
/coverage.out
/coverage.html
/coverage.txt
# Отчёты для сканера SonarQube. Узоры нарочно узкие, только в корне: широкий
# узор однажды проглотил исходник, и ворота этого не заметили.
/test-report.json
/golangci-report.xml
/govet-report.out
# Порождаемые наборы данных в корне. Косая черта в начале обязательна: без
# неё правило ловит любой каталог с таким именем на любой глубине, и под него
# попадал весь пакет cmd/corpus из семи исходников. В архив сдачи он не
# попадал, то есть инструмент сборки наборов просто не доезжал до жюри.
/corpus/
deploy/terraform/.terraform/
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/.terraform.lock.hcl
# Скомпилированные файлы: в архив с исходным кодом они попадать не должны.
*.test
/gen
/sonar
/score
/pii-guard
/loadgen
reports/

# Пробы из чужих наборов не выкладываются: лицензии не объявлены.
testdata/*_sample.jsonl
testdata/corpus-sample.jsonl
testdata/informal_*.jsonl
testdata/sample_ru_pii.jsonl

# Кеш разбора python от проверочных скриптов.
__pycache__/
*.pyc
