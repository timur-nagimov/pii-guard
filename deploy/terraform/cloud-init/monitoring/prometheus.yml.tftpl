# Сбор показателей стенда. Интервал пять секунд: на нагрузочном прогоне
# длительностью в минуты этого хватает, чтобы увидеть форму кривой, и не
# создаёт заметной нагрузки на сервис.
global:
  scrape_interval: 5s
  evaluation_interval: 15s

scrape_configs:
  - job_name: pii-guard
    metrics_path: /metrics
    static_configs:
      - targets: [${app_targets}]

  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:9100"]

  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:9090"]
