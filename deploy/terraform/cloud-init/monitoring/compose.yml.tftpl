# Наблюдение за стендом: сбор показателей и панель для жюри.
#
# Все три контейнера работают в сети машины (network_mode: host). Так
# Prometheus снимает показатели сервиса по 127.0.0.1 без пробросов, а панель
# доступна по внешнему адресу машины на порту ${grafana_port}.
services:
  prometheus:
    image: prom/prometheus:v3.1.0
    restart: unless-stopped
    network_mode: host
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time=${retention}
      - --web.listen-address=127.0.0.1:9090
    volumes:
      - /opt/pii-guard/monitoring/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - prometheus-data:/prometheus

  node-exporter:
    image: prom/node-exporter:v1.8.2
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
      - --web.listen-address=127.0.0.1:9100
    volumes:
      - /:/host:ro,rslave

  grafana:
    image: grafana/grafana:11.6.0
    restart: unless-stopped
    network_mode: host
    environment:
      GF_SERVER_HTTP_PORT: "${grafana_port}"
      GF_AUTH_ANONYMOUS_ENABLED: "true"
      GF_AUTH_ANONYMOUS_ORG_ROLE: Viewer
      GF_AUTH_DISABLE_LOGIN_FORM: "true"
      GF_SECURITY_ALLOW_EMBEDDING: "true"
      GF_USERS_DEFAULT_THEME: light
    volumes:
      - /opt/pii-guard/monitoring/grafana:/etc/grafana/provisioning:ro
      - grafana-data:/var/lib/grafana

volumes:
  prometheus-data:
  grafana-data:
