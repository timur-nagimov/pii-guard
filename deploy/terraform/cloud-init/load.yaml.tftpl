#cloud-config
# Облачная инициализация машины генератора нагрузки.
#
# Ставит Go, k6 и собирает инструменты прогона из исходного кода, чтобы
# нагрузочный прогон запускался одной командой сразу после создания машины.
users:
  - name: ubuntu
    groups: [sudo]
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
write_files:
  - path: /etc/sysctl.d/99-highload.conf
    encoding: b64
    content: ${sysctl_b64}
  - path: /etc/security/limits.d/99-nofile.conf
    encoding: b64
    content: ${limits_b64}
  - path: /etc/pii-guard/deploy.env
    permissions: '0644'
    encoding: b64
    content: ${deploy_env_b64}
  - path: /usr/local/bin/pii-load-deploy.sh
    permissions: '0755'
    encoding: b64
    content: ${deploy_script_b64}
  - path: /usr/local/bin/pii-load.sh
    permissions: '0755'
    encoding: b64
    content: ${load_script_b64}
package_update: true
packages: [docker.io, docker-compose-v2, make, git, jq, htop, unzip, ca-certificates, curl, gnupg]
runcmd:
  - sysctl --system
  - systemctl enable --now docker
  - usermod -aG docker ubuntu
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://dl.k6.io/key.gpg | gpg --dearmor -o /etc/apt/keyrings/k6.gpg
  - echo 'deb [signed-by=/etc/apt/keyrings/k6.gpg] https://dl.k6.io/deb stable main' > /etc/apt/sources.list.d/k6.list
  - apt-get update && apt-get install -y k6
  - /usr/local/bin/pii-load-deploy.sh
  - echo 'STAND=load ready' > /var/log/stand-ready
