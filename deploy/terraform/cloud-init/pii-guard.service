[Unit]
Description=Модуль безопасности персональных данных
Documentation=https://github.com/alfa-hackathon/pii-guard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pii-guard
EnvironmentFile=/opt/pii-guard/pii.env
ExecStart=/opt/pii-guard/pii-guard -config /opt/pii-guard/configs/config.yaml
ExecReload=/bin/kill -HUP $MAINPID

# Остановка. Сервис обязан получить сигнал завершения и доработать принятые
# запросы сам: обрыв соединения на полпути для маскирующего сервиса означает,
# что клиент не получил ни исходного текста, ни маски.
#
# SIGTERM это значение systemd по умолчанию, но здесь оно задано явно: от того,
# какой сигнал придёт процессу, зависит, будет мягкая остановка или обрыв.
KillSignal=SIGTERM
# Сигнал получает только главный процесс, дочерние добиваются по истечении
# предела. Сервис дочерних процессов не порождает, поэтому разница видна лишь
# в одном случае: команда, запущенная кем-то в том же cgroup, не собьёт отсчёт.
KillMode=mixed

# Предел мягкой остановки. Расчёт целиком в docs/BALANCING.md, раздел
# «Мягкий вывод копии из обслуживания», числа берутся из настроек проверки
# готовности в deploy/terraform/balancer.tf и выводятся как balancer_drain_plan:
#
#   5 с   балансировщик замечает снятие готовности: период 2 с умножить на
#         порог 2 неудачи плюс предел ожидания 1 с
#   2 с   запас на разброс проверок, balancer_drain_margin
#   ----
#   7 с   столько сервис держит приём открытым после сигнала, local.lb_drain_seconds
#  15 с   предел ожидания завершения, server.shutdown_timeout; он же с запасом
#         перекрывает таймаут записи ответа в 9 с, то есть добивание принятых
#         запросов укладывается внутрь
#   ----
#  22 с   полная остановка по расчёту
#
# Ставим 30 с: те же 22 с плюс 8 с запаса на медленную машину и на будущий рост
# пределов. Умолчание systemd, 90 с, формально ничего не ломает, но по нему
# нельзя понять, считал ли кто-нибудь это число, и оно втрое дольше нужного:
# при выкладке группа ждёт каждую копию именно столько.
TimeoutStopSec=30

# Перезапуск при падении. always, а не on-failure: при штатной остановке
# командой systemctl stop перезапуска не будет в любом случае, а вот выход с
# нулевым кодом из-за внутренней ошибки поднять копию обязан.
Restart=always
RestartSec=2
LimitNOFILE=1048576
# Право занять порты 80 и 443 без запуска от имени суперпользователя.
AmbientCapabilities=CAP_NET_BIND_SERVICE
User=ubuntu

[Install]
WantedBy=multi-user.target
